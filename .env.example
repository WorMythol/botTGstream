# ─── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Your Telegram user ID (get from @userinfobot) – becomes the Owner
OWNER_TELEGRAM_ID=123456789

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://botuser:botpassword@localhost:5432/streambot

# ─── YouTube ─────────────────────────────────────────────────────────────────
# Google Cloud Console → Enable "YouTube Data API v3" → Create API key
YOUTUBE_API_KEY=AIzaSy...

# Daily quota limit (default Google quota is 10,000 units/day)
YOUTUBE_DAILY_QUOTA_LIMIT=10000
YOUTUBE_QUOTA_WARNING_THRESHOLD=8000

# ─── Twitch ───────────────────────────────────────────────────────────────────
# dev.twitch.tv → Register application → Client Credentials
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# ─── VK ───────────────────────────────────────────────────────────────────────
# vk.com/dev → My Apps → Service Access Key (used for READING stream status)
VK_ACCESS_TOKEN=your_vk_service_access_token
VK_API_VERSION=5.199

# Feature 12: VK Bot API (community bot token — for SENDING messages to VK)
# vk.com/dev → Community management → API usage → Key for community messages
VK_GROUP_TOKEN=your_vk_community_bot_token
VK_GROUP_ID=0          # numeric group ID (positive integer)

# ─── Polling intervals (seconds) ─────────────────────────────────────────────
POLL_INTERVAL_YOUTUBE=300
POLL_INTERVAL_TWITCH=300
POLL_INTERVAL_VK=300

# ─── Reliability ──────────────────────────────────────────────────────────────
REQUEST_TIMEOUT=15          # HTTP timeout in seconds for platform API calls
# Disable streamer monitoring after N consecutive API errors
MAX_CONSECUTIVE_ERRORS=5
# Cooldown in seconds before re-notifying after a stream ends (30 min default)
STREAM_COOLDOWN_SECONDS=1800

# ─── Feature 5: Webhook mode ─────────────────────────────────────────────────
# Leave WEBHOOK_URL empty to use long polling (default, easier for development)
# Set to your public HTTPS URL to enable webhook mode (recommended for production)
# Example: https://yourdomain.com
WEBHOOK_URL=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8443
# Random secret token to authenticate Telegram webhook requests
WEBHOOK_SECRET=

# ─── Feature 4: REST API ─────────────────────────────────────────────────────
# Secret key for REST API access (X-Api-Key header)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=your_api_secret_key_here

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# ─── Sprint 2: Backup ────────────────────────────────────────────────────────
# Directory to store pg_dump backups. Leave empty to disable.
# Example: /var/backups/streambot
BACKUP_DIR=
# Keep backups for this many days before pruning
BACKUP_KEEP_DAYS=7

# ─── Sprint 2: Telegram Mini App ─────────────────────────────────────────────
# Public URL where miniapp/index.html is hosted.
# Used in /help or bot messages as a button link.
# Example: https://yourdomain.com/miniapp/index.html
MINIAPP_URL=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
