# ─── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Your Telegram user ID (get from @userinfobot) – becomes the Owner
OWNER_TELEGRAM_ID=123456789

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://botuser:botpassword@localhost:5432/streambot

# ─── YouTube ─────────────────────────────────────────────────────────────────
# Google Cloud Console → Enable "YouTube Data API v3" → Create API key
YOUTUBE_API_KEY=AIzaSy...

# Daily quota limit (default Google quota is 10,000 units/day)
YOUTUBE_DAILY_QUOTA_LIMIT=10000
YOUTUBE_QUOTA_WARNING_THRESHOLD=8000

# ─── Twitch ───────────────────────────────────────────────────────────────────
# dev.twitch.tv → Register application → Client Credentials
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# ─── VK ───────────────────────────────────────────────────────────────────────
# vk.com/dev → My Apps → Service Access Key
VK_ACCESS_TOKEN=your_vk_service_access_token
VK_API_VERSION=5.199

# ─── Polling intervals (seconds) ─────────────────────────────────────────────
POLL_INTERVAL_YOUTUBE=300
POLL_INTERVAL_TWITCH=300
POLL_INTERVAL_VK=300

# ─── Reliability ──────────────────────────────────────────────────────────────
# Disable streamer monitoring after N consecutive API errors
MAX_CONSECUTIVE_ERRORS=5
# Cooldown in seconds before re-notifying after a stream ends (30 min default)
STREAM_COOLDOWN_SECONDS=1800

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
